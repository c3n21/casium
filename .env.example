# Copy to .env at the repo root. The provider API and agent load it automatically
# (`node --env-file-if-exists=../../.env`), and `pnpm demo:up` sources it too.
#
# The browser does NOT read this file. Web app settings live in apps/web/.env.local
# and are inlined at build time — see apps/web/.env.example.
#
# With no .env at all, everything runs in mock mode against testnet Sui.

# ---------------------------------------------------------------------------
# Provider API
# ---------------------------------------------------------------------------
# memory   = in-process Maps; packets and applications are lost on restart
# postgres = durable; requires `pnpm db:up && pnpm db:migrate` first
PROVIDER_STORE=postgres
DATABASE_URL=postgres://rentdelegate:rentdelegate@localhost:5432/rentdelegate
PROVIDER_API_URL=http://localhost:4021

# ---------------------------------------------------------------------------
# World AgentKit
# ---------------------------------------------------------------------------
# Anything other than exactly "real" falls back to the mock verifier, which
# accepts x-demo-* headers from anyone. Never leave this unset on a public host.
AGENTKIT_MODE=real
AGENTKIT_EVM_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public
# AGENTKIT_DEBUG=1 makes the provider log *why* a header was rejected.

# --- Agent side: how the agent authenticates to a real-mode provider ---
# Preferred. The agent signs a fresh header for each request URL, which is what the
# provider validates. The address MUST be registered in AgentBook:
#   pnpm dlx @worldcoin/agentkit-cli register 0xYOUR_AGENT_EVM_ADDRESS
# Use a dedicated agent key, not your personal MetaMask key. NEVER COMMIT THIS.
AGENT_EVM_PRIVATE_KEY=
# AGENTKIT_CHAIN_ID=eip155:480

# Alternative: one pre-signed header from scripts/agentkit-live-request.html. Valid for
# a single URL until it expires, so it breaks on any other listing or host.
# AGENTKIT_HEADER=

# Mock-mode pair used by the agent. Both must be set, and the provider must be in
# mock mode. Proves the Sui path only — never cite it as World verification.
AGENTKIT_DEMO_HUMAN_ID_HASH=sha256:local-demo
AGENTKIT_DEMO_AGENT_EVM_ADDRESS=0x662DbABBeff9B237490bBE6A898776a4A1D87CCe

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# mock = in-memory stub; http = real Walrus testnet publisher/aggregator
WALRUS_MODE=real
# WALRUS_PUBLISHER_URL / WALRUS_AGGREGATOR_URL override the public testnet defaults
WALRUS_EPOCHS=5

# ---------------------------------------------------------------------------
# Agent
# ---------------------------------------------------------------------------
AGENT_SERVER_PORT=4022
MANDATE_ID=0x835478969ce38a0a1d0f981aa1a278a8862f9283de735ebba81c6169d388dbee
AGENT_SUI_ADDRESS=0x371321932fb4c4b79b9b0762ac0878ebfb670cc6f6327ecf9d1d06cd9489243e
# Optional; by default the agent discovers the AgentCap for MANDATE_ID.
# AGENT_CAP_ID=
# Required to actually sign. Without it the agent stops at a PTB-only fallback.
# NEVER COMMIT THIS.
# AGENT_SUI_PRIVATE_KEY=suiprivkey...

# Landlord document-access window written onto the receipt. Must stay inside the
# packet blob's Walrus lifetime (5 epochs ≈ 5 days) or the run aborts before gas.
AGENT_ACCESS_WINDOW_DAYS=3
