{
  "name": "rentdelegate",
  "version": "0.0.0",
  "private": true,
  "description": "RentDelegate monorepo for scoped rental application agents on Sui and World.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "demo:duplicate-human": "pnpm --filter @rentdelegate/provider-api build && node scripts/demo-agentkit-duplicate.mjs",
    "test": "pnpm -r --if-present test",
    "lint:object-ids": "node scripts/check-object-ids.mjs"
  }
}
