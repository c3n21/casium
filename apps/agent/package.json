{
  "name": "@rentdelegate/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:env": "node --env-file-if-exists=../../.env dist/checkEnv.js",
    "test": "vitest run",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "start:server": "node --env-file-if-exists=../../.env dist/server.js",
    "dev:server": "tsx src/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "@mysten/sui": "^2.22.1",
    "@rentdelegate/agentkit": "workspace:*",
    "@rentdelegate/contracts-config": "workspace:*",
    "@rentdelegate/shared": "workspace:*",
    "@rentdelegate/sui-client": "workspace:*",
    "@rentdelegate/walrus": "workspace:*",
    "@worldcoin/agentkit": "^0.2.0",
    "ethers": "^6.17.0",
    "hono": "^4.12.31"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
