# Web app configuration. Copy to `.env.local` (gitignored) and restart `next dev`
# after any change — Next.js inlines NEXT_PUBLIC_* at build time, so a hot reload
# will not pick up edits.
#
# With none of these set, the app runs fully mocked: AES-GCM encryption with the
# key in browser memory, and an in-memory Walrus stub that emits `mock:` blob IDs.
# See the "Web app: mock vs live packet upload" section of the root README.

# mock = AES-GCM in the browser (offline dev)
# seal = policy-gated Seal encryption; also requires PacketBuilder to receive a
#        listingObjectId, otherwise it silently falls back to the mock branch
NEXT_PUBLIC_ENCRYPTION_MODE=seal

# mock = in-memory stub, blobs discarded after upload (PacketViewer cannot read them)
# http = real Walrus testnet publisher/aggregator (no credentials needed)
NEXT_PUBLIC_WALRUS_MODE=http

# Provider API that packet records are registered with.
NEXT_PUBLIC_PROVIDER_API_URL=http://localhost:4021

# Blob lifetime used only for the expiry estimate shown in the UI. The uploader
# reads WALRUS_EPOCHS, which is not exposed to the browser bundle, so uploads use
# the adapter default of 5 epochs.
NEXT_PUBLIC_WALRUS_EPOCHS=5
